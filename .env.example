# ─────────────────────────────────────────────────────────────
#  Tolti AI — Environment Configuration
#  Copy to .env and adjust as needed for your on-prem setup.
# ─────────────────────────────────────────────────────────────

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_DB=tolti
POSTGRES_USER=tolti
POSTGRES_PASSWORD=tolti
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tolti:tolti@postgres:5432/tolti

# ── MinIO ────────────────────────────────────────────────────
MINIO_ROOT_USER=tolti
MINIO_ROOT_PASSWORD=tolti
MINIO_BUCKET=evidence
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── AI Engine (Python) ──────────────────────────────────────
AI_ENGINE_PORT=8000

# Default model endpoint (OpenAI-compatible, e.g. Ollama, vLLM, LM Studio)
# Override per-model in the admin UI once the app is up.
MODEL_DEFAULT_BASE_URL=http://host.docker.internal:11434/v1
MODEL_DEFAULT_API_KEY=ollama

# ── Backend (TypeScript) ────────────────────────────────────
BACKEND_PORT=3001
JWT_SECRET=change-me-in-production-tolti-sovereign-secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ── Frontend (React) ────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
